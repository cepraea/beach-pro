{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",

  // Base oficial para coexistência entre markdownlint e Prettier.
  // Regras de formatação que podem disputar responsabilidade com o Prettier
  // permanecem desativadas pelo preset.
  "extends": "markdownlint/style/prettier",

  // MD001 — heading-increment
  // Não permite pular níveis de títulos, por exemplo de H1 diretamente para H3.
  "heading-increment": true,

  // MD004 — ul-style
  // Padroniza listas não ordenadas usando "-".
  "ul-style": {
    "style": "dash"
  },

  // MD024 — no-duplicate-heading
  // Proíbe títulos duplicados somente entre títulos irmãos.
  "no-duplicate-heading": {
    "siblings_only": true
  },

  // MD025 — single-title
  // Permite apenas um H1 por documento e reconhece título em front matter.
  "single-title": {
    "front_matter_title": "^\\s*title\\s*[:=]"
  },

  // MD026 — no-trailing-punctuation
  // Proíbe pontuação terminal comum em headings, preservando ! e ?.
  "no-trailing-punctuation": {
    "punctuation": ".,;:"
  },

  // MD028 — no-blanks-blockquote
  // Desativada para permitir estruturas de blockquote/callout existentes.
  "no-blanks-blockquote": false,

  // MD013 — line-length
  // O Prettier é responsável por decisões de quebra/formatação de linhas.
  "line-length": false,

  // MD031 — blanks-around-fences
  // Mantida sob responsabilidade de formatação do Prettier.
  "blanks-around-fences": false,

  // MD060 — table-column-style
  // O Prettier é responsável pela formatação visual das tabelas.
  "table-column-style": false,

  // MD033 — no-inline-html
  // HTML continua proibido por padrão, exceto elementos explicitamente permitidos.
  "no-inline-html": {
    "allowed_elements": [
      "a",
      "abbr",
      "annotation",
      "br",
      "caption",
      "code",
      "col",
      "colgroup",
      "dd",
      "details",
      "div",
      "dl",
      "dt",
      "em",
      "h4",
      "h5",
      "img",
      "kbd",
      "li",
      "math",
      "mdn-scrim-inline",
      "menclose",
      "mfenced",
      "mfrac",
      "mi",
      "mmultiscripts",
      "mn",
      "mo",
      "mover",
      "mphantom",
      "mprescripts",
      "mroot",
      "mrow",
      "ms",
      "mspace",
      "msqrt",
      "mstyle",
      "msub",
      "msubsup",
      "msup",
      "mtable",
      "mtd",
      "mtext",
      "mtr",
      "munder",
      "munderover",
      "none",
      "ol",
      "p",
      "pre",
      "q",
      "section",
      "semantics",
      "strong",
      "sub",
      "summary",
      "sup",
      "table",
      "tbody",
      "td",
      "tfoot",
      "th",
      "thead",
      "tr",
      "ul",
      "var"
    ]
  },

  // MD034 — no-bare-urls
  // Mantida desativada conforme a configuração existente do repositório.
  "no-bare-urls": false,

  // MD037 — no-space-in-emphasis
  // Mantida desativada para evitar falsos positivos no conteúdo existente.
  "no-space-in-emphasis": false,

  // MD040 — fenced-code-language
  // Todo bloco cercado deve declarar uma linguagem reconhecida.
  "fenced-code-language": {
    "allowed_languages": [
      "apacheconf",
      "bash",
      "batch",
      "c",
      "cpp",
      "cs",
      "css",
      "css-nolint",
      "diff",
      "django",
      "glsl",
      "hbs",
      "hbs-nolint",
      "html",
      "html-nolint",
      "http",
      "ini",
      "java",
      "js",
      "js-nolint",
      "json",
      "json-nolint",
      "jsx",
      "jsx-nolint",
      "latex",
      "md",
      "md-nolint",
      "mermaid",
      "nginx",
      "php",
      "plain",
      "powershell",
      "pug",
      "python",
      "regex",
      "rust",
      "scss",
      "sh",
      "sql",
      "svelte",
      "svg",
      "text",
      "toml",
      "ts",
      "txt",
      "url",
      "vue",
      "wat",
      "webidl",
      "xml",
      "yaml",
      "markdown"
    ]
  },

  // MD042 — no-empty-links
  // Mantida desativada conforme a configuração existente.
  "no-empty-links": false,

  // MD046 — code-block-style
  // Exige blocos de código cercados por ``` em vez de blocos indentados.
  "code-block-style": {
    "style": "fenced"
  },

  // MD051 — link-fragments
  // Mantida desativada enquanto a convenção de geração de âncoras do projeto
  // não estiver formalizada.
  "link-fragments": false,

  // MD059 — descriptive-link-text
  // Proíbe textos de link genéricos e pouco descritivos.
  "descriptive-link-text": {
    "prohibited_texts": [
      "here",
      "link",
      "more",
      "this",
      "this link",
      "this page",
      "this site",
      "this article",
      "click here",
      "click this link",
      "see here",
      "see this page",
      "see this site",
      "see this article"
  ]
},
 
// MD041 — first-line-heading
// Garante que todo documento tenha um título principal claro.
"first-line-heading": {
  "level": 1,
  "front_matter_title": "^\\s*title\\s*[:=]"
},

// MD044 — proper-names
// Mantém grafia/capitalização consistente de nomes importantes do projeto.
"proper-names": {
  "names": [
    "CEPRAEA",
    "GitHub",
    "JavaScript",
    "Markdown",
    "Node.js",
    "PostgreSQL",
    "Prettier",
    "Pydantic",
    "Pyright",
    "Python"
  ],
  "code_blocks": false,
  "html_elements": false
  }
}