{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CEPRAEA: iniciar desenvolvimento",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Local:.*http://localhost:5173/.*"
        }
      }
    },
    {
      "label": "CEPRAEA: validar projeto",
      "type": "npm",
      "script": "validate",
      "problemMatcher": []
    },
    {
      "label": "CEPRAEA: executar testes",
      "type": "npm",
      "script": "test",
      "problemMatcher": []
    },
    {
      "label": "CEPRAEA: verificar tipos",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "CEPRAEA: build de produção",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    }
  ]
}
