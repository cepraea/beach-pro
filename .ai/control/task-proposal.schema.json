{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cepraea.local/schema/2.0/task-proposal.schema.json",
  "title": "CEPRAEA BEACH PRO Task Proposal",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "object_type",
    "schema_version",
    "proposal_id",
    "revision",
    "task_id",
    "title",
    "original_instruction",
    "objective",
    "problem",
    "actor",
    "valid_context",
    "invalid_context",
    "preconditions",
    "dependencies",
    "normative_source",
    "inputs_and_contracts",
    "current_behavior",
    "expected_behavior",
    "relevant_states",
    "in_scope",
    "out_of_scope",
    "included_edge_cases",
    "three_amigos",
    "business_rules",
    "decisions",
    "constraints",
    "allowed_actions",
    "prohibited_actions",
    "allowed_technical_autonomy",
    "files",
    "human_decisions_already_made",
    "pending_human_decisions",
    "risk",
    "runbook_binding",
    "stop_conditions",
    "acceptance_criteria",
    "mandatory_checks",
    "expected_evidence",
    "definition_of_done"
  ],

  "properties": {
    "object_type": { "const": "task_proposal" },
    "schema_version": { "const": "2.0" },
    "proposal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "integer", "minimum": 1 },

    "task_id": { "type": "string", "minLength": 1, "maxLength": 128, "description": "ID (task_atomics.md)." },
    "title": { "type": "string", "minLength": 1 },
    "original_instruction": { "type": "string", "minLength": 1, "description": "Texto literal recebido de Davi que originou esta proposta." },
    "objective": { "type": "string", "minLength": 1 },
    "problem": { "type": "string", "minLength": 1, "description": "O problema que a tarefa resolve, distinto do objetivo (a solucao)." },
    "actor": { "type": "string", "minLength": 1 },

    "valid_context": { "type": "string", "minLength": 1 },
    "invalid_context": { "type": "string", "minLength": 1, "description": "Usar 'Nao aplicavel' quando nao houver contexto invalido relevante." },

    "preconditions": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "string", "minLength": 1, "description": "Outras tarefas, decisoes (DEC-NNN) ou artefatos dos quais esta tarefa depende. Usar 'Nenhuma' quando nao houver." },
    "normative_source": { "type": "string", "minLength": 1 },
    "inputs_and_contracts": { "type": "string", "minLength": 1 },

    "current_behavior": { "type": "string", "minLength": 1, "description": "Usar 'N/A - nova feature' quando nao houver comportamento atual." },
    "expected_behavior": { "type": "string", "minLength": 1 },
    "relevant_states": { "type": "string", "minLength": 1 },

    "in_scope": { "type": "string", "minLength": 1 },
    "out_of_scope": { "type": "string", "minLength": 1 },
    "included_edge_cases": { "type": "string", "minLength": 1 },

    "three_amigos": { "$ref": "#/$defs/threeAmigos" },
    "business_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/idText" },
      "description": "{rule_id, rule}[] (task_atomics.md secao 3.1)."
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decisionEntry" },
      "description": "{decision_id, decision}[] - decisoes humanas ja tomadas que restringem a implementacao (nao confundir com human_decisions_already_made, que e o resumo em prosa)."
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraintEntry" },
      "description": "{constraint_id, scope, constraint}[]."
    },

    "allowed_actions": { "type": "string", "minLength": 1 },
    "prohibited_actions": { "type": "string", "minLength": 1, "description": "Equivalente a MUST NOT (task_atomics.md secao 6)." },
    "allowed_technical_autonomy": { "type": "string", "minLength": 1 },

    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fileScope" }
    },

    "human_decisions_already_made": { "type": "string", "minLength": 1 },
    "pending_human_decisions": {
      "type": "string",
      "minLength": 1,
      "description": "Toda pendencia real aqui impede PASS do plano ate resolvida ou registrada como HUMAN_DECISION_REQUIRED. Usar 'Nenhuma' quando nao houver."
    },

    "risk": { "$ref": "#/$defs/risk" },
    "runbook_binding": { "$ref": "#/$defs/runbookBinding" },

    "stop_conditions": { "type": "string", "minLength": 1 },

    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/acceptanceCriterion" }
    },
    "mandatory_checks": { "type": "string", "minLength": 1 },
    "expected_evidence": { "type": "string", "minLength": 1 },
    "definition_of_done": { "type": "string", "minLength": 1 },

    "bdd": {
      "$ref": "#/$defs/bdd",
      "description": "Preencher somente quando algum criterio de aceite descrever comportamento observavel (task_atomics.md secao 5). Omitir quando nao aplicavel."
    }
  },

  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },

    "idText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "rule"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 }
      }
    },

    "decisionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "decision"],
      "properties": {
        "decision_id": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "minLength": 1 }
      }
    },

    "constraintEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "scope", "constraint"],
      "properties": {
        "constraint_id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "constraint": { "type": "string", "minLength": 1 }
      }
    },

    "threeAmigos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_business", "development", "quality"],
      "properties": {
        "domain_business": { "type": "string", "minLength": 1 },
        "development": { "type": "string", "minLength": 1 },
        "quality": { "type": "string", "minLength": 1 }
      }
    },

    "fileScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "operation"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "role": {
          "enum": ["target", "reference", "read_only", "forbidden"],
          "description": "Mesma classificacao de CLAUDE.md (Proposta proporcional): alvo|referencia|somente_leitura|proibido."
        },
        "operation": {
          "enum": ["read", "change", "none"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "target" } } },
          "then": { "properties": { "operation": { "const": "change" } } }
        },
        {
          "if": { "properties": { "role": { "enum": ["reference", "read_only"] } } },
          "then": { "properties": { "operation": { "const": "read" } } }
        },
        {
          "if": { "properties": { "role": { "const": "forbidden" } } },
          "then": { "properties": { "operation": { "const": "none" } } }
        }
      ]
    },

    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "natures", "blast_radius", "reversibility", "justification"],
      "properties": {
        "level": {
          "enum": ["verde", "amarelo", "vermelho", "vermelho_critico"],
          "description": "AGENT_POLICY.md - Classificacao de risco. Valores fixos, nao traduzir."
        },
        "natures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["ui", "dependencia", "rls", "mfa", "ci", "dados"]
          },
          "description": "AGENT_POLICY.md - enum fechado. Uma tarefa de banco de dados usa 'dados'; nao existe categoria 'database' separada."
        },
        "blast_radius": { "enum": ["baixo", "medio", "alto"] },
        "reversibility": { "enum": ["reversivel", "parcial", "irreversivel"] },
        "justification": { "type": "string", "minLength": 1 }
      }
    },

    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "method", "expected"],
      "properties": {
        "condition": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 }
      }
    },

    "bddStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyword", "text"],
      "properties": {
        "keyword": { "enum": ["Given", "When", "Then", "And", "But"] },
        "text": { "type": "string", "minLength": 1 }
      }
    },

    "bddExamplesTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headers", "rows"],
      "properties": {
        "headers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },

    "bddScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "steps", "examples"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["scenario", "scenario_outline"] },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bddStep" }
        },
        "examples": {
          "type": "array",
          "items": { "$ref": "#/$defs/bddExamplesTable" },
          "description": "Obrigatorio quando kind=scenario_outline (pelo menos uma tabela); array vazio quando kind=scenario."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "scenario_outline" } } },
          "then": { "properties": { "examples": { "minItems": 1 } } }
        }
      ]
    },

    "bddRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "scenarios"],
      "properties": {
        "rule": { "type": "string", "minLength": 1 },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bddScenario" }
        }
      }
    },

    "bdd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "rules"],
      "properties": {
        "feature": { "type": "string", "minLength": 1 },
        "background": {
          "type": "array",
          "items": { "$ref": "#/$defs/bddStep" },
          "description": "Opcional - omitir quando nao houver passo comum a todos os cenarios."
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bddRule" }
        }
      }
    },

    "runbookBinding": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "operation_classes",
        "applicable_runbooks"
      ],

      "properties": {
        "operation_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "code_change",
              "database_change",
              "documentation_change",
              "dependency_change"
            ]
          },
          "description": "runbooks/README.md - enum fechado de 4 classes. Nao existem 'backend_change', 'validation_change' ou 'test_change' como classes proprias."
        },

        "applicable_runbooks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shared",
            "executor",
            "reviewer"
          ],
          "properties": {
            "shared": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "runbooks/shared/RB-SHARED-001-repository-baseline.md",
                  "runbooks/shared/RB-SHARED-002-evidence.md",
                  "runbooks/shared/RB-SHARED-003-failure-states.md"
                ]
              }
            },

            "executor": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "runbooks/executor/RB-EXEC-001-code-change.md",
                  "runbooks/executor/RB-EXEC-002-database-change.md",
                  "runbooks/executor/RB-EXEC-003-documentation-change.md",
                  "runbooks/executor/RB-EXEC-004-dependency-change.md"
                ]
              }
            },

            "reviewer": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "runbooks/reviewer/RB-REV-001-code-review.md",
                  "runbooks/reviewer/RB-REV-002-database-review.md",
                  "runbooks/reviewer/RB-REV-003-documentation-review.md",
                  "runbooks/reviewer/RB-REV-004-evidence-review.md",
                  "runbooks/reviewer/RB-REV-005-dependency-review.md"
                ]
              }
            }
          }
        }
      },

      "allOf": [
        { "$ref": "#/$defs/codeChangeBinding" },
        { "$ref": "#/$defs/databaseChangeBinding" },
        { "$ref": "#/$defs/documentationChangeBinding" },
        { "$ref": "#/$defs/dependencyChangeBinding" }
      ]
    },

    "codeChangeBinding": {
      "if": {
        "properties": { "operation_classes": { "contains": { "const": "code_change" } } }
      },
      "then": {
        "properties": {
          "applicable_runbooks": {
            "properties": {
              "executor": { "contains": { "const": "runbooks/executor/RB-EXEC-001-code-change.md" } },
              "reviewer": { "contains": { "const": "runbooks/reviewer/RB-REV-001-code-review.md" } }
            }
          }
        }
      },
      "else": {
        "properties": {
          "applicable_runbooks": {
            "properties": {
              "executor": { "not": { "contains": { "const": "runbooks/executor/RB-EXEC-001-code-change.md" } } },
              "reviewer": { "not": { "contains": { "const": "runbooks/reviewer/RB-REV-001-code-review.md" } } }
            }
          }
        }
      }
    },

    "databaseChangeBinding": {
      "if": {
        "properties": { "operation_classes": { "contains": { "const": "database_change" } } }
      },
      "then": {
        "properties": {
          "applicable_runbooks": {
            "properties": {
              "executor": { "contains": { "const": "runbooks/executor/RB-EXEC-002-database-change.md" } },
              "reviewer": { "contains": { "const": "runbooks/reviewer/RB-REV-002-database-review.md" } }
            }
          }
        }
      },
      "else": {
        "properties": {
          "applicable_runbooks": {
            "properties": {
              "executor": { "not": { "contains": { "const": "runbooks/executor/RB-EXEC-002-database-change.md" } } },
              "reviewer": { "not": { "contains": { "const": "runbooks/reviewer/RB-REV-002-database-review.md" } } }
            }
          }
        }
      }
    },

    "documentationChangeBinding": {
      "if": {
        "properties": { "operation_classes": { "contains": { "const": "documentation_change" } } }
      },
      "then": {
        "properties": {
          "applicable_runbooks": {
            "properties": {
              "executor": { "contains": { "const": "runbooks/executor/RB-EXEC-003-documentation-change.md" } },
              "reviewer": { "contains": { "const": "runbooks/reviewer/RB-REV-003-documentation-review.md" } }
            }
          }
        }
      },
      "else": {
        "properties": {
          "applicable_runbooks": {
            "properties": {
              "executor": { "not": { "contains": { "const": "runbooks/executor/RB-EXEC-003-documentation-change.md" } } },
              "reviewer": { "not": { "contains": { "const": "runbooks/reviewer/RB-REV-003-documentation-review.md" } } }
            }
          }
        }
      }
    },

    "dependencyChangeBinding": {
      "if": {
        "properties": { "operation_classes": { "contains": { "const": "dependency_change" } } }
      },
      "then": {
        "properties": {
          "applicable_runbooks": {
            "properties": {
              "executor": { "contains": { "const": "runbooks/executor/RB-EXEC-004-dependency-change.md" } },
              "reviewer": { "contains": { "const": "runbooks/reviewer/RB-REV-005-dependency-review.md" } }
            }
          }
        }
      },
      "else": {
        "properties": {
          "applicable_runbooks": {
            "properties": {
              "executor": { "not": { "contains": { "const": "runbooks/executor/RB-EXEC-004-dependency-change.md" } } },
              "reviewer": { "not": { "contains": { "const": "runbooks/reviewer/RB-REV-005-dependency-review.md" } } }
            }
          }
        }
      }
    }
  }
}
