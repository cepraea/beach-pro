{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cepraea.local/schema/3.0/task-proposal.schema.json",
  "title": "CEPRAEA BEACH PRO Task Proposal v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "proposal_id",
    "revision",
    "task_id",
    "title",
    "original_instruction",
    "goal",
    "problem",
    "actor",
    "context",
    "outputs",
    "preconditions",
    "dependencies",
    "normative_sources",
    "current_behavior",
    "expected_behavior",
    "relevant_states",
    "boundaries",
    "included_edge_cases",
    "three_amigos",
    "business_rules",
    "decisions",
    "constraints",
    "files",
    "pending_human_decisions",
    "risk",
    "runbook_binding",
    "acceptance_criteria",
    "actions",
    "mandatory_checks",
    "definition_of_done"
  ],
  "properties": {
    "object_type": {
      "const": "task_proposal"
    },
    "schema_version": {
      "const": "3.0"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9._-]{2,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "original_instruction": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "invalid"
      ],
      "properties": {
        "valid": {
          "type": "string",
          "minLength": 1
        },
        "invalid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "output_id",
          "description"
        ],
        "properties": {
          "output_id": {
            "type": "string",
            "pattern": "^OUT-[0-9]{3,}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "normative_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "locator"
        ],
        "properties": {
          "kind": {
            "enum": [
              "file",
              "decision",
              "human_instruction"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "current_behavior": {
      "type": "string",
      "minLength": 1
    },
    "expected_behavior": {
      "type": "string",
      "minLength": 1
    },
    "relevant_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "out_of_scope",
        "allowed_actions",
        "prohibited_actions",
        "allowed_technical_autonomy",
        "stop_conditions"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prohibited_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_technical_autonomy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "included_edge_cases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "three_amigos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_business",
        "development",
        "quality"
      ],
      "properties": {
        "domain_business": {
          "type": "string",
          "minLength": 1
        },
        "development": {
          "type": "string",
          "minLength": 1
        },
        "quality": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "business_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "rule"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "decision"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "constraint_id",
          "scope",
          "constraint"
        ],
        "properties": {
          "constraint_id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "constraint": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "operation"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "role": {
            "enum": [
              "target",
              "reference",
              "read_only",
              "forbidden"
            ]
          },
          "operation": {
            "enum": [
              "read",
              "change",
              "none"
            ]
          }
        }
      }
    },
    "pending_human_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "natures",
        "blast_radius",
        "reversibility",
        "justification"
      ],
      "properties": {
        "level": {
          "enum": [
            "verde",
            "amarelo",
            "vermelho",
            "vermelho_critico"
          ]
        },
        "natures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ui",
              "dependencia",
              "rls",
              "mfa",
              "ci",
              "dados"
            ]
          }
        },
        "blast_radius": {
          "enum": [
            "baixo",
            "medio",
            "alto"
          ]
        },
        "reversibility": {
          "enum": [
            "reversivel",
            "parcial",
            "irreversivel"
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runbook_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_version",
        "operation_classes",
        "repository_baseline_required",
        "evidence_review_required"
      ],
      "properties": {
        "catalog_version": {
          "const": "1.0"
        },
        "operation_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "code_change",
              "database_change",
              "documentation_change",
              "dependency_change"
            ]
          }
        },
        "repository_baseline_required": {
          "type": "boolean"
        },
        "evidence_review_required": {
          "type": "boolean"
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "output_refs",
          "condition",
          "method",
          "expected",
          "verification_owner"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^AC-[0-9]{3,}$"
          },
          "output_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^OUT-[0-9]{3,}$"
            }
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "verification_owner": {
            "enum": [
              "deterministic",
              "reviewer",
              "human"
            ]
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "action",
          "purpose",
          "depends_on",
          "acceptance_criteria_refs",
          "target_files",
          "expected_evidence"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^A-[0-9]{3,}$"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^A-[0-9]{3,}$"
            }
          },
          "acceptance_criteria_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{3,}$"
            }
          },
          "target_files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "mandatory_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "kind",
          "command",
          "expected_exit_code"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^CHK-[0-9]{3,}$"
          },
          "kind": {
            "enum": [
              "schema",
              "lint",
              "typecheck",
              "test",
              "build",
              "git",
              "security",
              "custom"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "expected_exit_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "definition_of_done": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_acceptance_criteria_refs",
        "required_check_refs",
        "no_unauthorized_changes",
        "no_pending_human_decisions"
      ],
      "properties": {
        "required_acceptance_criteria_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^AC-[0-9]{3,}$"
          }
        },
        "required_check_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CHK-[0-9]{3,}$"
          }
        },
        "no_unauthorized_changes": {
          "const": true
        },
        "no_pending_human_decisions": {
          "const": true
        }
      }
    },
    "bdd": {
      "type": "object"
    }
  }
}
