{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cepraea.local/schema/2.0/execution-result.schema.json",
  "title": "CEPRAEA BEACH PRO Execution Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "execution_id",
    "task_id",
    "proposal_binding",
    "approval_binding",
    "runtime_anchor",
    "preflight",
    "handoff_status",
    "termination_reason",
    "started_at",
    "completed_at",
    "actions",
    "changes",
    "evidence",
    "final_checks",
    "unauthorized_changes",
    "summary"
  ],
  "properties": {
    "object_type": {
      "const": "execution_result"
    },
    "schema_version": {
      "const": "2.0"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^EXE-[A-Z0-9._-]{3,127}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "proposal_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "revision",
        "proposal_sha256"
      ],
      "properties": {
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "proposal_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "approval_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "approval_sha256"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "minLength": 1
        },
        "approval_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "runtime_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "base_commit",
        "head_commit"
      ],
      "properties": {
        "repository": {
          "const": "cepraea/beach-pro"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "main",
              "master"
            ]
          }
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{7,64}$"
        },
        "head_commit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{7,64}$"
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "completed_at",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "name",
              "status",
              "details"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              },
              "details": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "handoff_status": {
      "enum": [
        "READY_FOR_REVIEW",
        "BLOCKED"
      ]
    },
    "termination_reason": {
      "enum": [
        "NONE",
        "FAILED_VALIDATION",
        "PREFLIGHT_BLOCKED",
        "STOPPED_CONTRACT_INVALID",
        "STOPPED_APPROVAL_MISMATCH",
        "STOPPED_RUNTIME_DRIFT",
        "STOPPED_PRECONDITION_FAILED",
        "STOPPED_DEPENDENCY_UNSATISFIED",
        "STOPPED_SCOPE_VARIANCE",
        "STOPPED_SEMANTIC_VARIANCE",
        "STOPPED_CONTRACT_AMBIGUITY",
        "STOPPED_HUMAN_DECISION_REQUIRED",
        "STOPPED_FORBIDDEN_FILE_ACCESS",
        "STOPPED_UNAUTHORIZED_DEPENDENCY_CHANGE",
        "STOPPED_UNAUTHORIZED_DATABASE_CHANGE",
        "STOPPED_RUNBOOK_VIOLATION",
        "STOPPED_RISK_ESCALATION",
        "STOPPED_EVIDENCE_IMPOSSIBLE",
        "STOPPED_RULES_INTEGRITY_FAILURE"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "status",
          "acceptance_criteria_refs",
          "files_changed",
          "evidence_refs",
          "notes"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^A-[0-9]{3,}$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAILED",
              "BLOCKED",
              "NOT_EXECUTED"
            ]
          },
          "acceptance_criteria_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{3,}$"
            }
          },
          "files_changed": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^EVD-[A-Z0-9._-]{3,127}$"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "change_id",
          "action_refs",
          "path",
          "operation",
          "authorized",
          "before_hash",
          "after_hash",
          "observed_at"
        ],
        "properties": {
          "change_id": {
            "type": "string",
            "pattern": "^CHG-[A-Z0-9._-]{3,127}$"
          },
          "action_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^A-[0-9]{3,}$"
            }
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "create",
              "modify",
              "delete",
              "rename"
            ]
          },
          "authorized": {
            "type": "boolean"
          },
          "before_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "after_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "action_refs",
          "acceptance_criteria_refs",
          "kind",
          "status",
          "summary",
          "observed_at",
          "simulated",
          "artifact_refs"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^EVD-[A-Z0-9._-]{3,127}$"
          },
          "action_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^A-[0-9]{3,}$"
            }
          },
          "acceptance_criteria_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{3,}$"
            }
          },
          "kind": {
            "enum": [
              "test",
              "build",
              "lint",
              "typecheck",
              "schema_validation",
              "command",
              "diff",
              "file_snapshot",
              "runtime_log",
              "query_result",
              "migration_check",
              "dependency_audit",
              "other"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "INFO"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "simulated": {
            "const": false
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "artifact_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "final_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "evidence_refs",
          "details"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^CHK-[0-9]{3,}$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^EVD-[A-Z0-9._-]{3,127}$"
            }
          },
          "details": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unauthorized_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
