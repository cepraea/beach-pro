{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.cepraea.local/schemas/fonte.schema.json",
  "title": "Fonte documental",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "title",
    "description",
    "source_type",
    "location",
    "authority",
    "captured_at",
    "classification",
    "content_hash",
    "status",
    "immutable_reference",
    "verified_at",
    "verified_by",
    "permitted_uses",
    "prohibited_uses"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^SRC-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "source_type": {
      "enum": ["human", "document", "system", "official_record", "observation"]
    },
    "location": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "scope"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "items": {"type": "string"}}
      }
    },
    "captured_at": {"type": "string", "format": "date-time"},
    "classification": {
      "enum": ["primary", "supporting", "historical", "candidate"]
    },
    "content_hash": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": ["active", "superseded", "revoked", "unverified"]
    },
    "immutable_reference": {"type": ["string", "null"]},
    "verified_at": {"type": ["string", "null"], "format": "date-time"},
    "verified_by": {"type": ["string", "null"]},
    "permitted_uses": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "prohibited_uses": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "active"}}},
      "then": {
        "anyOf": [
          {
            "properties": {
              "content_hash": {"type": "string"},
              "immutable_reference": {"type": "string", "minLength": 1}
            }
          },
          {
            "properties": {
              "source_type": {"enum": ["human", "observation"]},
              "immutable_reference": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    }
  ]
}
