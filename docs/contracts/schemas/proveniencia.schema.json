{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.cepraea.local/schemas/proveniencia.schema.json",
  "title": "Pacote de proveniência documental",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provenance_id",
    "document_id",
    "document_version",
    "document_hash",
    "created_at",
    "created_by",
    "policy",
    "sources",
    "claims"
  ],
  "properties": {
    "provenance_id": {
      "type": "string",
      "pattern": "^PROV-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "document_id": {
      "type": "string",
      "pattern": "^DOC-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "document_version": {"type": "string", "minLength": 1},
    "document_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical_coverage_percent",
        "require_active_sources",
        "reject_ambiguous_references"
      ],
      "properties": {
        "critical_coverage_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "require_active_sources": {"type": "boolean"},
        "reject_ambiguous_references": {"type": "boolean"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    }
  }
}
