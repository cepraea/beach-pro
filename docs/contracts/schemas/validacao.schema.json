{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.cepraea.local/schemas/validacao.schema.json",
  "title": "Registro de validação",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "validation_id",
    "object",
    "protocol_id",
    "validator",
    "validated_at",
    "criteria",
    "overall_status",
    "corrective_action_ids",
    "evidence_ids"
  ],
  "properties": {
    "validation_id": {"type": "string", "pattern": "^VAL-[A-Z0-9-]+$"},
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "version", "content_hash"],
      "properties": {
        "document_id": {"type": "string", "pattern": "^DOC-"},
        "version": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "protocol_id": {"type": "string", "minLength": 1},
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "role"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "validated_at": {"type": "string", "format": "date-time"},
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "status", "evidence_ids", "findings"],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "blocked", "not_applicable"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "findings": {"type": "array", "items": {"type": "string"}}
        }
      },
      "minItems": 1
    },
    "overall_status": {"enum": ["pass", "fail", "blocked"]},
    "corrective_action_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}}
  }
}
