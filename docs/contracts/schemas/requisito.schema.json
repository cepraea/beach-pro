{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.cepraea.local/schemas/requisito.schema.json",
  "title": "Requisito controlado",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirement_id",
    "version",
    "description",
    "source_ids",
    "decision_ids",
    "phase",
    "status",
    "acceptance_criteria",
    "dependencies",
    "approved_by",
    "approved_at"
  ],
  "properties": {
    "requirement_id": {"type": "string", "pattern": "^RF-(?:[0-9]{3}|P[0-9]{2})$"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "source_ids": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "decision_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "phase": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["derived", "candidate", "validated", "approved", "rejected", "superseded"]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "approved_by": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "approved"}}},
      "then": {
        "properties": {
          "acceptance_criteria": {"minItems": 1},
          "approved_by": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  ]
}
