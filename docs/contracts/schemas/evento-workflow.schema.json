{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.cepraea.local/schemas/evento-workflow.schema.json",
  "title": "Evento de workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "workflow_id",
    "transition_id",
    "document_id",
    "version",
    "content_hash",
    "event_type",
    "actor",
    "from_state",
    "to_state",
    "occurred_at",
    "gate_result_ids",
    "evidence_ids",
    "reason"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^EVT-[A-Z0-9-]+$"},
    "workflow_id": {"const": "WF-DOC-CEPRAEA"},
    "transition_id": {"type": "string", "pattern": "^T-DOC-[0-9]{3}$"},
    "document_id": {"type": "string", "pattern": "^DOC-"},
    "version": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "event_type": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "role"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "from_state": {"type": "string", "minLength": 1},
    "to_state": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "gate_result_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string", "minLength": 1}
  }
}
