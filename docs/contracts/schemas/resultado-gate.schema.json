{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.cepraea.local/schemas/resultado-gate.schema.json",
  "title": "Resultado de gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_result_id",
    "gate_id",
    "document_id",
    "version",
    "content_hash",
    "status",
    "evaluated_at",
    "evaluator",
    "evaluator_role",
    "evidence_ids",
    "failures",
    "next_actions"
  ],
  "properties": {
    "gate_result_id": {"type": "string", "pattern": "^GATE-RESULT-[A-Z0-9-]+$"},
    "gate_id": {"type": "string", "pattern": "^G(?:-[A-Z]+|[0-9]+)$"},
    "document_id": {"type": ["string", "null"]},
    "version": {"type": ["string", "null"]},
    "content_hash": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {"enum": ["pass", "fail", "blocked", "not_applicable"]},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "evaluator": {"type": "string", "minLength": 1},
    "evaluator_role": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "failures": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pass"}}},
      "then": {"properties": {"failures": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["fail", "blocked"]}}},
      "then": {"properties": {"failures": {"minItems": 1}}}
    }
  ]
}
