{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cepraea.local/schema/1.0/execution-result.schema.json",
  "title": "CEPRAEA Executor v1 Execution Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "execution_id",
    "executor_run_id",
    "proposal_id",
    "proposal_revision",
    "proposal_hash",
    "approval_binding",
    "runtime_anchor",
    "preflight",
    "final_status",
    "started_at",
    "completed_at",
    "contract_integrity",
    "actions",
    "changes",
    "deviations",
    "evidence",
    "final_checks",
    "unauthorized_changes",
    "stop_event",
    "summary"
  ],
  "properties": {
    "object_type": {
      "const": "execution_result"
    },
    "schema_version": {
      "const": "1.0"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "executor_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "proposal_revision": {
      "type": "integer",
      "minimum": 1
    },
    "proposal_hash": {
      "$ref": "#/$defs/sha256"
    },
    "approval_binding": {
      "$ref": "#/$defs/approvalBinding"
    },
    "runtime_anchor": {
      "$ref": "#/$defs/runtimeAnchor"
    },
    "preflight": {
      "$ref": "#/$defs/preflight"
    },
    "final_status": {
      "enum": [
        "IMPLEMENTATION_READY_FOR_REVIEW",
        "FAILED_VALIDATION",
        "PREFLIGHT_BLOCKED",
        "STOPPED"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "contract_integrity": {
      "$ref": "#/$defs/contractIntegrity"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/actionResult"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/changeEntry"
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deviationEntry"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceEntry"
      }
    },
    "final_checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finalCheck"
      }
    },
    "unauthorized_changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/changeEntry"
      }
    },
    "stop_event": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/stopEvent"
        }
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "approvalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_status",
        "approved_proposal_id",
        "approved_revision",
        "approved_hash"
      ],
      "properties": {
        "gate_status": {
          "const": "READY_FOR_IMPLEMENTATION"
        },
        "approved_proposal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "approved_revision": {
          "type": "integer",
          "minimum": 1
        },
        "approved_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtimeAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "base_commit",
        "working_tree_policy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base_commit": {
          "type": "string",
          "minLength": 7,
          "maxLength": 128
        },
        "working_tree_policy": {
          "enum": [
            "clean_required",
            "contract_allowed_changes_only"
          ]
        }
      }
    },
    "preflightCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "name",
        "status",
        "details"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "details": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "completed_at",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/preflightCheck"
          }
        }
      }
    },
    "contractIntegrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_hash_matches",
        "proposal_revision_matches",
        "approval_binding_matches",
        "runtime_anchor_matches",
        "rules_integrity_ok"
      ],
      "properties": {
        "proposal_hash_matches": {
          "type": "boolean"
        },
        "proposal_revision_matches": {
          "type": "boolean"
        },
        "approval_binding_matches": {
          "type": "boolean"
        },
        "runtime_anchor_matches": {
          "type": "boolean"
        },
        "rules_integrity_ok": {
          "type": "boolean"
        }
      }
    },
    "actionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "status",
        "acceptance_criteria_refs",
        "files_changed",
        "evidence_refs",
        "notes"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "PASS",
            "FAILED",
            "BLOCKED",
            "NOT_EXECUTED"
          ]
        },
        "acceptance_criteria_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "files_changed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "changeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "action_refs",
        "path",
        "operation",
        "authorized",
        "before_hash",
        "after_hash"
      ],
      "properties": {
        "change_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "operation": {
          "enum": [
            "create",
            "modify",
            "delete",
            "rename"
          ]
        },
        "authorized": {
          "type": "boolean"
        },
        "before_hash": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "after_hash": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        }
      }
    },
    "deviationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviation_id",
        "kind",
        "disposition",
        "action_id",
        "description"
      ],
      "properties": {
        "deviation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "MINOR_TECHNICAL_VARIANCE",
            "CONTRACT_AMBIGUITY",
            "SEMANTIC_VARIANCE",
            "SCOPE_VARIANCE",
            "DEPENDENCY_VARIANCE",
            "HUMAN_DECISION_REQUIRED",
            "RISK_VARIANCE"
          ]
        },
        "disposition": {
          "enum": [
            "CONTINUE",
            "STOP"
          ]
        },
        "action_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "action_refs",
        "acceptance_criteria_refs",
        "kind",
        "status",
        "summary",
        "artifact_refs"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "acceptance_criteria_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "kind": {
          "enum": [
            "test",
            "build",
            "lint",
            "typecheck",
            "schema_validation",
            "command",
            "diff",
            "file_snapshot",
            "runtime_log",
            "query_result",
            "migration_check",
            "dependency_audit",
            "other"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "INFO"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "artifact_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    },
    "finalCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "name",
        "status",
        "evidence_refs",
        "details"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "details": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stopEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "description",
        "action_id",
        "recoverability"
      ],
      "properties": {
        "code": {
          "enum": [
            "STOP_CONTRACT_INVALID",
            "STOP_APPROVAL_MISMATCH",
            "STOP_RUNTIME_DRIFT",
            "STOP_PRECONDITION_FAILED",
            "STOP_DEPENDENCY_UNSATISFIED",
            "STOP_SCOPE_VARIANCE",
            "STOP_SEMANTIC_VARIANCE",
            "STOP_CONTRACT_AMBIGUITY",
            "STOP_HUMAN_DECISION_REQUIRED",
            "STOP_FORBIDDEN_FILE_ACCESS",
            "STOP_UNAUTHORIZED_DEPENDENCY_CHANGE",
            "STOP_UNAUTHORIZED_DATABASE_CHANGE",
            "STOP_RUNBOOK_VIOLATION",
            "STOP_RISK_ESCALATION",
            "STOP_EVIDENCE_IMPOSSIBLE",
            "STOP_RULES_INTEGRITY_FAILURE"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "recoverability": {
          "enum": [
            "REPLAN_REQUIRED",
            "HUMAN_DECISION_REQUIRED",
            "ENVIRONMENT_FIX_REQUIRED",
            "CONTRACT_REAPPROVAL_REQUIRED"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "final_status": {
            "const": "IMPLEMENTATION_READY_FOR_REVIEW"
          }
        },
        "required": [
          "final_status"
        ]
      },
      "then": {
        "properties": {
          "preflight": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "stop_event": {
            "type": "null"
          },
          "unauthorized_changes": {
            "maxItems": 0
          },
          "actions": {
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            }
          },
          "changes": {
            "items": {
              "properties": {
                "authorized": {
                  "const": true
                }
              }
            }
          },
          "deviations": {
            "items": {
              "properties": {
                "kind": {
                  "const": "MINOR_TECHNICAL_VARIANCE"
                },
                "disposition": {
                  "const": "CONTINUE"
                }
              }
            }
          },
          "evidence": {
            "minItems": 1
          },
          "final_checks": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            }
          },
          "contract_integrity": {
            "properties": {
              "proposal_hash_matches": {
                "const": true
              },
              "proposal_revision_matches": {
                "const": true
              },
              "approval_binding_matches": {
                "const": true
              },
              "runtime_anchor_matches": {
                "const": true
              },
              "rules_integrity_ok": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "final_status": {
            "const": "PREFLIGHT_BLOCKED"
          }
        },
        "required": [
          "final_status"
        ]
      },
      "then": {
        "properties": {
          "preflight": {
            "properties": {
              "status": {
                "const": "BLOCKED"
              }
            }
          },
          "stop_event": {
            "$ref": "#/$defs/stopEvent"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "final_status": {
            "const": "STOPPED"
          }
        },
        "required": [
          "final_status"
        ]
      },
      "then": {
        "properties": {
          "stop_event": {
            "$ref": "#/$defs/stopEvent"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "final_status": {
            "const": "FAILED_VALIDATION"
          }
        },
        "required": [
          "final_status"
        ]
      },
      "then": {
        "properties": {
          "preflight": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          }
        },
        "anyOf": [
          {
            "properties": {
              "actions": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "FAILED"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "final_checks": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "FAIL"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  ]
}
