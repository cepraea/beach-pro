{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cepraea.local/schemas/checker-report.schema.json",
  "title": "Checker Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checker_run_id",
    "checker_id",
    "checker_role",
    "review_policy_version",
    "candidate_artifact_id",
    "candidate_content_hash",
    "uc_id",
    "source_id",
    "segment_ids",
    "result",
    "checked_fields",
    "findings",
    "limitations"
  ],
  "properties": {
    "checker_run_id": { "type": "string", "pattern": "^CHK-[A-Z0-9-]+$" },
    "checker_id": { "type": "string", "minLength": 1 },
    "checker_role": { "const": "CHECKER" },
    "review_policy_version": { "type": "string", "minLength": 1 },
    "candidate_artifact_id": { "type": "string", "minLength": 1 },
    "candidate_artifact_version": { "type": "string", "minLength": 1 },
    "candidate_content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source_hashes": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
    "uc_id": { "type": "string", "pattern": "^UC-F[0-9]{2}-[0-9]{6}$" },
    "source_id": { "type": "string", "minLength": 1 },
    "segment_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "result": { "enum": ["CONFORME", "DIVERGENCIA_ENCONTRADA", "INCONCLUSIVO"] },
    "checked_fields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "field", "source_evidence", "source_locator", "divergence_type", "impact", "rationale", "recommended_action"],
        "properties": {
          "finding_id": { "type": "string", "pattern": "^DIV-[A-Z0-9-]+$" },
          "field": { "type": "string", "minLength": 1 },
          "claim_checked": { "type": "string" },
          "source_evidence": { "type": "string", "minLength": 1 },
          "source_locator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "segment_id"],
            "properties": {
              "source_id": { "type": "string", "minLength": 1 },
              "segment_id": { "type": "string", "minLength": 1 },
              "additional_locator": { "type": "string" }
            }
          },
          "divergence_type": { "type": "string", "minLength": 1 },
          "impact": { "enum": ["EDITORIAL", "MATERIAL", "ALTO", "CRITICO"] },
          "rationale": { "type": "string", "minLength": 1 },
          "recommended_action": { "enum": ["CORRECAO_DETERMINISTICA", "HUMAN_EXCEPTION_REVIEW", "BLOQUEAR_PACOTE"] }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
