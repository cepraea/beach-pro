{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cepraea.local/schemas/risk-classification.schema.json",
  "title": "Risk Classification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classification_id",
    "action_id",
    "classification_policy_version",
    "dimensions",
    "mandatory_triggers",
    "assigned_lane",
    "rationale",
    "classified_by"
  ],
  "properties": {
    "classification_id": { "type": "string", "pattern": "^RISK-[A-Z0-9-]+$" },
    "action_id": { "type": "string", "pattern": "^ACT-F[0-9]{2}-[0-9]{3}(\\.[0-9]+)*$" },
    "classification_policy_version": { "type": "string", "minLength": 1 },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact", "propagation", "reversibility", "ambiguity", "sensitivity"],
      "properties": {
        "impact": { "enum": ["BAIXO", "MODERADO", "ALTO", "CRITICO"] },
        "propagation": { "enum": ["LOCAL", "LIMITADA", "TRANSVERSAL", "SISTEMICA"] },
        "reversibility": { "enum": ["IMEDIATA", "SIMPLES", "CUSTOSA", "IRREVERSIVEL"] },
        "ambiguity": { "enum": ["NENHUMA", "BAIXA", "MATERIAL", "CRITICA"] },
        "sensitivity": { "enum": ["PUBLICA", "INTERNA", "PESSOAL", "SENSIVEL"] }
      }
    },
    "mandatory_triggers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "assigned_lane": { "enum": ["VIA_RAPIDA", "VIA_CONTROLADA", "VIA_CRITICA"] },
    "rationale": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "input_hashes": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
    "classified_by": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
