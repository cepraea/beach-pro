{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cepraea.local/schemas/approval-record.schema.json",
  "title": "Approval Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "action_id",
    "artifact_id",
    "artifact_version",
    "content_hash",
    "package_hash",
    "decision",
    "approver_id",
    "approval_scope"
  ],
  "properties": {
    "approval_id": { "type": "string", "pattern": "^APR-[A-Z0-9-]+$" },
    "action_id": { "type": "string", "minLength": 1 },
    "artifact_id": { "type": "string", "minLength": 1 },
    "artifact_version": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "package_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "schema_id": { "type": "string" },
    "schema_version": { "type": "string" },
    "approval_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "decision": { "enum": ["APROVADO", "APROVADO_COM_RESSALVAS", "REPROVADO", "BLOQUEADO"] },
    "approver_id": { "type": "string", "pattern": "^HUM-[A-Z0-9-]+$" },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
