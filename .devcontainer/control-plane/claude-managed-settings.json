{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "allowManagedHooksOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(sudo *)",
      "Bash(docker *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git worktree *)",
      "Bash(git clean *)",
      "Bash(git rm *)",
      "Bash(git stash *)",
      "Bash(git update-ref *)",
      "Read(//home/agent/.ssh/**)",
      "Read(//home/agent/.aws/**)",
      "Read(//home/agent/.config/gh/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.drive/CEPRAEA BEACH PRO/**)",
      "Read(./.drive/BEACH HANDBALL/**)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npx *)"
    ]
  },
   "sandbox": {
     "enabled": false
   },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/lib/cepraea-guards/pretool"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/lib/cepraea-guards/posttool"
          }
        ]
      }
    ]
  }
}
