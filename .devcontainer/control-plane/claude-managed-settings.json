{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "allowManagedHooksOnly": true,
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(docker *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Read(//home/agent/.ssh/**)",
      "Read(//home/agent/.aws/**)",
      "Read(//home/agent/.config/gh/**)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npx *)"
    ]
  },
  "sandbox": {
    "enabled": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/lib/cepraea-guards/pretool"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/lib/cepraea-guards/posttool"
          }
        ]
      }
    ]
  }
}
