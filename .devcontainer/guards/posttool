#!/usr/bin/env bash
set -euo pipefail
state_dir="/home/agent/.local/state/cepraea-guards"
mkdir -p "$state_dir"
payload="$(cat)"
tool="$(jq -r '.tool_name // "desconhecido"' <<<"$payload")"
printf '{"observado_em":"%s","tool":"%s"}\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  "$tool" \
  >> "$state_dir/events.jsonl"
exit 0
